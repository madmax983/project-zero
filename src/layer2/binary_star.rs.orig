use bevy_ecs::prelude::*;
use std::time::Duration;
use crate::layer1::temperature::TemperatureGrid;

#[derive(Component)]
pub struct SolarPanel {
    pub base_output: f32,
    pub current_output: f32,
}

#[derive(Component)]
pub struct Crop {
    pub growth: f32,
    pub health: f32,
    pub needs_rest: bool,
}

#[derive(Default, PartialEq, Clone, Copy, Debug)]
pub enum BinaryPhase {
    #[default]
    Normal,
    DoubleNoon,
    TheLongDay,
}

#[derive(Resource, Default)]
pub struct BinaryStarSystem {
    pub star1_intensity: f32,
    pub star2_intensity: f32,
    pub current_phase: BinaryPhase,
    pub heat_wave_chance: f32,
}

#[derive(Event, Default)]
pub struct HeatWaveEvent;

pub fn binary_star_system(
    binary: Res<BinaryStarSystem>,
    mut solar: Query<&mut SolarPanel>,
) {
    for mut s in solar.iter_mut() {
        s.current_output = s.base_output;
        if binary.current_phase == BinaryPhase::DoubleNoon {
            s.current_output *= 1.6;
        }
    }
}

pub fn binary_star_crop_system(
    binary: Res<BinaryStarSystem>,
    mut crops: Query<&mut Crop>,
) {
    if binary.current_phase == BinaryPhase::TheLongDay {
        for mut c in crops.iter_mut() {
            if c.needs_rest {
                c.health -= 1.0;
            }
        }
    }
}

pub fn binary_star_heat_system(
    binary: Res<BinaryStarSystem>,
    mut heat_events: EventWriter<HeatWaveEvent>,
    mut temp_grid: Option<ResMut<TemperatureGrid>>,
) {
    use rand::Rng;
    if rand::thread_rng().gen_range(0.0..1.0) <= binary.heat_wave_chance {
        heat_events.send(HeatWaveEvent);
        if let Some(ref mut grid) = temp_grid {
            for i in 0..grid.values.len() {
                grid.values[i] += 5.0; // Raise temperature on heat wave
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use bevy::prelude::*;

    #[test]
    fn test_binary_star_fluctuating_solar_power() {
        let mut app = bevy::app::App::new();
        app.add_systems(Update, binary_star_system);

        // Arrange: Generate a Binary Star system and place a Solar Panel on Layer 1
        let panel = app.world_mut().spawn(SolarPanel { base_output: 10.0, current_output: 0.0 }).id();
        let binary_system = BinaryStarSystem { star1_intensity: 1.0, star2_intensity: 1.0, current_phase: BinaryPhase::DoubleNoon, ..Default::default() };
        app.insert_resource(binary_system);

        // Act: Advance time through the complex dual-orbit day cycle
        app.update();

        // Assert: Verify solar power output spikes during "Double Noon" and drops normally otherwise
        let updated_panel = app.world().get::<SolarPanel>(panel).unwrap();
        assert!(updated_panel.current_output > updated_panel.base_output * 1.5);
    }

    #[test]
    fn test_binary_star_crop_withering_without_rest() {
        let mut app = bevy::app::App::new();
        app.insert_resource(Time::default());
        app.add_systems(Update, binary_star_crop_system);

        // Arrange: Generate a Binary Star system causing "The Long Day" and plant crops
        let crop = app.world_mut().spawn(Crop { growth: 0.0, health: 100.0, needs_rest: true }).id();
        let binary_system = BinaryStarSystem { current_phase: BinaryPhase::TheLongDay, ..Default::default() };
        app.insert_resource(binary_system);

        // Act: Advance time without building blackout protection
        app.world_mut().resource_mut::<Time<bevy::time::Real>>().advance_by(Duration::from_secs(100));
        app.update();

        // Assert: Verify crops fail to progress or wither due to lack of a dark rest cycle
        let updated_crop = app.world().get::<Crop>(crop).unwrap();
        assert!(updated_crop.health < 100.0);
        assert_eq!(updated_crop.growth, 0.0);
    }

    #[test]
    fn test_binary_star_heat_waves() {
        let mut app = bevy::app::App::new();
        app.add_event::<HeatWaveEvent>();
        app.add_systems(Update, binary_star_heat_system);

        // Arrange: Generate a Binary Star system
        let binary_system = BinaryStarSystem { current_phase: BinaryPhase::DoubleNoon, heat_wave_chance: 1.0, ..Default::default() };
        app.insert_resource(binary_system);

        let mut grid = TemperatureGrid::new(10, 10, 20.0);
        app.insert_resource(grid);

        // Act: Advance time
        app.update();

        // Assert: Verify random heat wave events trigger, raising local temperature grids on Layer 1
        let events = app.world().resource::<Events<HeatWaveEvent>>();
        assert!(!events.is_empty());
        let updated_grid = app.world().resource::<TemperatureGrid>();
        let mut sum = 0.0;
        for v in &updated_grid.values {
            sum += v;
        }
        let avg = sum / updated_grid.values.len() as f32;
        assert!(avg > 20.0);
    }
}
