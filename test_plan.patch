+
+/// Monitors drone power. If parent hub is destroyed or loses power, drones idle.
+pub fn drone_power_monitor_system(
+    mut commands: Commands,
+    mut query: Query<(Entity, &ParentHub, &mut PopAction), With<Drone>>,
+    hub_query: Query<&PowerConsumer, With<DroneHub>>,
+) {
+    for (entity, parent_hub, mut action) in &mut query {
+        let mut hub_active = false;
+        if let Ok(power) = hub_query.get(parent_hub.0) {
+            hub_active = power.active;
+        }
+
+        if !hub_active && action.current != ActionType::Idle && action.current != ActionType::Charge {
+            action.current = ActionType::Idle;
+            action.current_utility = 1.0;
+            commands.entity(entity).remove::<StartPlan>();
+        }
+    }
+}
